# ==============================================================================
# HIRON WEB FRONTEND DOCKERFILE SKELETON (Next.js 15)
# ==============================================================================
# Multi-stage, non-root Node.js container infrastructure skeleton.

# Stage 1: Base setup
FROM node:20-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

# Stage 2: Production Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

# Security: Non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

USER nextjs

EXPOSE 3000

# Note: HTTP health check will be enabled in Phase 1 after Next.js app initialization.

# Infrastructure skeleton placeholder: long-running command for container orchestration
CMD ["sleep", "infinity"]
