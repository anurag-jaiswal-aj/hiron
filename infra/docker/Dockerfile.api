# ==============================================================================
# HIRON CORE API DOCKERFILE SKELETON (FastAPI)
# ==============================================================================
# Multi-stage, non-root, production-grade container infrastructure skeleton.

# Stage 1: Build & Environment Preparation
FROM python:3.12-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Runtime Production Image
FROM python:3.12-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Security: Create non-root user
RUN groupadd -g 10001 hiron && \
    useradd -u 10001 -g hiron -m -s /bin/bash hiron

# Install runtime system libraries (libpq for PostgreSQL driver)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

USER hiron

EXPOSE 8000

# Note: HTTP health check (/api/v1/health) will be enabled in Phase 1 after FastAPI app initialization.

# Infrastructure skeleton placeholder: long-running command for container orchestration
CMD ["sleep", "infinity"]
