# ==============================================================================
# HIRON PLATFORM ENVIRONMENT CONFIGURATION BLUEPRINT
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real keys!

# ------------------------------------------------------------------------------
# 1. Application & Core API Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
LOG_LEVEL=DEBUG                        # DEBUG | INFO | WARNING | ERROR
PORT=8000
API_V1_PREFIX=/api/v1
APP_SECRET_KEY=your_app_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Tokens (§16.1)
# ------------------------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. Database & PostgreSQL Configuration (§10 & Database Design)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hiron_dev
POSTGRES_USER=hiron_user
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password_here@localhost:5432/hiron_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. Redis & Celery Task Queue (§10 & Database Design §1)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. AWS S3 & Resume Storage (§15.2 & Database Design §5.7)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_BUCKET_RESUMES=hiron-resumes-dev

# ------------------------------------------------------------------------------
# 6. AI Services & OpenAI Configuration (Appendix A)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_SCORING_MODEL=gpt-4o-2024-08-06
SPACY_MODEL_VERSION=en_core_web_trf-3.7.3

# ------------------------------------------------------------------------------
# 7. Rate Limiting Limits per Plan Tier (API Contract §13)
# ------------------------------------------------------------------------------
RATE_LIMIT_STARTER_PER_MIN=60
RATE_LIMIT_PRO_PER_MIN=200
RATE_LIMIT_ENTERPRISE_PER_MIN=600
