# ==============================================================================
# HIRON PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
API_V1_PREFIX=/api/v1
NEXT_PUBLIC_API_URL=https://api.hiron.ai
APP_SECRET_KEY=ReplaceWith64CharacterRandomHexStringProductionKey
ALLOWED_ORIGINS=["https://app.hiron.ai", "https://hiron.ai"]

# JWT Authentication
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/etc/hiron/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/hiron/keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database (RDS Multi-AZ)
POSTGRES_HOST=hiron-production-db.c123456789.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=hiron_production
POSTGRES_USER=hiron_admin
POSTGRES_PASSWORD=ReplaceWithStrongDBPassword32Chars
DATABASE_URL=postgresql+asyncpg://hiron_admin:ReplaceWithStrongDBPassword32Chars@hiron-production-db.c123456789.us-east-1.rds.amazonaws.com:5432/hiron_production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Redis & Cache Cluster
REDIS_URL=rediss://hiron-prod-redis.123456.use1.cache.amazonaws.com:6379/0

# AI Service & Model Providers
OPENAI_API_KEY=sk-proj-ProductionOpenAIKeyHere
DEFAULT_LLM_MODEL=gpt-4o-2024-08-06
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Observability & Telemetry (Sentry & Datadog placeholders)
SENTRY_DSN=https://public@sentry.example.com/1
NEXT_PUBLIC_SENTRY_DSN=https://public@sentry.example.com/1
SENTRY_AUTH_TOKEN=sntrys_safe_ci_token_placeholder
DATADOG_API_KEY=ProductionDatadogApiKeyHere
