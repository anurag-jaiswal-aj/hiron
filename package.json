{
  "name": "hiron-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Hiron — AI-Powered Hiring Intelligence Platform Monorepo",
  "author": "Hiron Engineering Team <engineering@hiron.ai>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "type-check": "pnpm --recursive run type-check",
    "test": "pnpm --recursive run test",
    "clean": "pnpm --recursive run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.4"
  }
}
